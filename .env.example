# Get credentials from https://dashboard.sightengine.com/
SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Server-only local detector; start scripts/text-service.sh separately.
FAKESPOT_SERVICE_URL=http://127.0.0.1:8001

# Audio only: obtain in https://app.realitydefender.ai Settings → API Keys
# Keep your account on the Free plan; verify quota/retention in its dashboard.
REALITY_DEFENDER_API_KEY=your_reality_defender_api_key

# Server-only local WaveRep service (informational/nonprofit use only).
WAVEREP_SERVICE_URL=http://127.0.0.1:8002
# Python service reads WAVEREP_MAX_SECONDS from its shell (default 120, ceiling 120).
